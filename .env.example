# Template only. Never commit real credentials. Set these in Vercel's Production environment.
NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/calendar/callback
# Reuse the existing key if using the existing database; rotating it breaks saved connections.
GMAIL_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
# Optional; omit Calendar overrides to reuse the Gmail OAuth client.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# OPENAI_EMAIL_MODEL=

# Server-only provider receipt storage. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Release coordination scheduler authentication (server-only).
CRON_SECRET=
# Explicitly permitted controlled demo mailboxes, including the manager and stakeholders.
COORDINATION_DEMO_EMAILS=
# Optional structured-output model override.
# OPENAI_COORDINATION_MODEL=gpt-4.1-mini
